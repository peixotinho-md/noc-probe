# noc-pocket-probe - configuracao do cartao
# Copie para config.env e edite. config.env esta no .gitignore (contem segredos).

# --- Identidade ---------------------------------------------------------
HOSTNAME=noc-probe
USERNAME=noc
# Senha em texto plano (usada so para gerar o hash na sua maquina; nao vai para o cartao).
# Alternativamente preencha PASSWORD_HASH com a saida de: openssl passwd -6
PASSWORD=trocar-esta-senha
PASSWORD_HASH=
# Caminho para uma chave publica SSH (opcional, mas recomendado)
SSH_PUBKEY_FILE=

# --- Localizacao --------------------------------------------------------
TIMEZONE=America/Sao_Paulo
WIFI_COUNTRY=BR

# --- Wi-Fi (ate duas redes; prioridade maior = preferida) ---------------
WIFI1_SSID=
WIFI1_PSK=
WIFI1_PRIORITY=20
WIFI1_HIDDEN=false

WIFI2_SSID=
WIFI2_PSK=
WIFI2_PRIORITY=10
WIFI2_HIDDEN=false

# --- Acesso de emergencia por USB ---------------------------------------
# true = habilita ethernet-over-USB (dwc2/g_ether). Plugue o Pi na porta USB
# do notebook (conector "USB", nao o "PWR") e alcance ele por noc-probe.local
# mesmo sem Wi-Fi. Consome ~nada quando nao usado.
USB_GADGET=true

# --- Sistema ------------------------------------------------------------
# zram compensa os 512 MB de RAM do Zero 2 W
ENABLE_ZRAM=true

# Pacotes instalados no primeiro boot com rede. Corte o que nao usar.
#
# Os marcados (*) sao exigidos pelo noc-diag; tirando-os, os testes
# correspondentes viram SKIP em vez de quebrar.
#
#   caminho e latencia . mtr-tiny traceroute iputils-* fping ndisc6
#   endereco e enlace .. ethtool(*) iputils-arping(*) wireless-tools(*) iw(*)
#   descoberta ......... nmap arp-scan(*) lldpd(*) avahi-utils
#   dns ................ dnsutils(*)
#   captura ............ tcpdump
#   desempenho ......... iperf3 speedtest-cli iftop nload
#   sockets e tls ...... netcat-openbsd(*) socat curl(*) wget openssl whois ca-certificates
#   snmp ............... snmp
#   console serial ..... picocom  (com um adaptador USB-serial o probe vira
#                        console de switch/roteador - vale o espaco)
#   sistema ............ jq tmux htop less vim-tiny chrony libcap2-bin rfkill
#   compartilhamento ... nftables  (exigido pelo noc-share; sem ele o NAT nao sobe) nftables
PACKAGES=mtr-tiny traceroute iputils-ping iputils-arping iputils-tracepath fping ndisc6 ethtool wireless-tools iw nmap arp-scan lldpd avahi-utils dnsutils tcpdump iperf3 speedtest-cli iftop nload netcat-openbsd socat curl wget openssl whois ca-certificates snmp picocom jq tmux htop less vim-tiny chrony libcap2-bin rfkill nftables
